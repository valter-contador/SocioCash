# Copie este arquivo para ".env.local" (já cai no .gitignore) e preencha com os valores
# do seu projeto Supabase (Project Settings → API e → Database).

# Públicas — usadas pelo app no navegador (protegidas por Row Level Security, não por sigilo).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Secretas — NUNCA vão para o navegador. Usadas só localmente para publicar as Edge
# Functions e rodar o script de migração de dados (scripts/migrate-local-data.mjs).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=
